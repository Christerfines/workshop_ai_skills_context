+        app.MapPost("/api/bikes/{id}/activate", (HttpContext context, PortalStore store, string id) =>
+        {
+            var bike = store.Bikes.SingleOrDefault(item => item.Id == id && item.CustomerId == Customer(context));
+            if (bike is null) return Results.NotFound();
+            bike.ServiceStatus = "Active";
+            PortalAudit.Record(context, store, "Bike activated", bike.Id, "Customer activation");
+            return Results.Ok(bike);
+        });